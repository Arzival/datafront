# URL de la API del backend (repo datafromback), terminada en /api.
#   - Con ./scripts/dev.sh del backend: http://127.0.0.1:8000/api
#   - Con Laravel Herd:                 http://<carpeta-del-backend>.test/api
# Si la API no responde, la app arranca en el modo demo («Modo de ejemplo»:
# 27 referencias reales de ejemplo, no se guarda nada).
VITE_API_URL=http://127.0.0.1:8000/api

# Fuerza el modo de ejemplo aunque el backend responda (demos, desarrollo
# de la UI sin tocar datos reales).
# VITE_USE_MOCK=true
